#String length
set module_name "counter_top"
puts [string length $module_name]

#First five characters
puts [string range $module_name 0 4]

#Extract "top"
puts [string range $module_name 8 10]

#String Uppercase
puts [string toupper $module_name]

#Replace with"_"with"-"
puts [string map {_ -} $module_name]

